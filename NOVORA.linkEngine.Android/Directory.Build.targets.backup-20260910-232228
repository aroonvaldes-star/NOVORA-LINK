<Project>
  <PropertyGroup>
    <!-- Identidad Android que espera NOVORA Windows -->
    <ApplicationId>com.novora.linkengine</ApplicationId>
    <ApplicationTitle>NOVORA-LINK</ApplicationTitle>

    <!-- En Release queremos SIEMPRE un APK instalable por ADB -->
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">apk</AndroidPackageFormats>
    <AndroidBuildApplicationPackage Condition="'$(Configuration)' == 'Release'">true</AndroidBuildApplicationPackage>

    <!--
      Estructura:
        NOVORA-LINK\NOVORA.linkEngine.Android
        NOVORA-LINK\src\NOVORA
    -->
    <NovoraWindowsProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\src\NOVORA'))</NovoraWindowsProjectDir>
    <NovoraAndroidBundleDir>$(NovoraWindowsProjectDir)\Tools\Android</NovoraAndroidBundleDir>
    <NovoraAndroidBundleApk>$(NovoraAndroidBundleDir)\NOVORA.LinkEngine.Android.apk</NovoraAndroidBundleApk>
  </PropertyGroup>

  <!--
    Después de compilar Android en Release:
      1) Busca recursivamente el APK firmado.
      2) Crea Tools\Android si no existe.
      3) Copia el APK con el nombre fijo que consume NOVORA Windows.

    La búsqueda recursiva evita depender de que el SDK deje el APK
    exactamente en $(OutputPath).
  -->
  <Target Name="CopyNovoraAndroidClientToWindowsBundle"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">

    <ItemGroup>
      <_NovoraSignedApk Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\**\*-Signed.apk" />
    </ItemGroup>

    <MakeDir Directories="$(NovoraAndroidBundleDir)" />

    <Error Condition="'@(_NovoraSignedApk)' == ''"
           Text="NOVORA: Android compiló, pero no se encontró ningún *-Signed.apk bajo $(MSBuildProjectDirectory)\bin\$(Configuration). Verifica AndroidPackageFormats/firmado." />

    <Copy SourceFiles="@(_NovoraSignedApk)"
          DestinationFiles="@(_NovoraSignedApk->'$(NovoraAndroidBundleApk)')"
          SkipUnchangedFiles="true"
          Condition="'@(_NovoraSignedApk)' != ''" />

    <Message Importance="high"
             Condition="'@(_NovoraSignedApk)' != ''"
             Text="NOVORA Android bundle actualizado: $(NovoraAndroidBundleApk)" />
  </Target>
</Project>
