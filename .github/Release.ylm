name: NOVORA Release

on:
  push:
    tags:
      - "v*.*.*"

permissions:
  contents: write

jobs:
  build-release:
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "8.0.x"

      - name: Read version from tag
        id: version
        shell: pwsh
        run: |
          $tag = "${{ github.ref_name }}"

          if (-not $tag.StartsWith("v")) {
              throw "El tag debe comenzar con v."
          }

          $version = $tag.Substring(1)

          if ($version -notmatch '^\d+\.\d+\.\d+$') {
              throw "Formato de versión inválido: $version"
          }

          "VERSION=$version" | Out-File `
              -FilePath $env:GITHUB_OUTPUT `
              -Append

      - name: Restore
        run: dotnet restore

      - name: Publish NOVORA
        shell: pwsh
        run: |
          dotnet publish `
            -c Release `
            -r win-x64 `
            --self-contained false `
            -p:Version=${{ steps.version.outputs.VERSION }} `
            -p:AssemblyVersion=${{ steps.version.outputs.VERSION }}.0 `
            -p:FileVersion=${{ steps.version.outputs.VERSION }}.0 `
            -p:InformationalVersion=${{ steps.version.outputs.VERSION }} `
            -o "${{ github.workspace }}\publish"

      - name: Create update package
        shell: pwsh
        run: |
          $version = "${{ steps.version.outputs.VERSION }}"

          $zipName = "NOVORA-LINK-$version-win-x64.zip"
          $zipPath = "${{ github.workspace }}\$zipName"

          Compress-Archive `
            -Path "${{ github.workspace }}\publish\*" `
            -DestinationPath $zipPath `
            -CompressionLevel Optimal

          "ZIP_NAME=$zipName" |
            Out-File `
              -FilePath $env:GITHUB_ENV `
              -Append

          "ZIP_PATH=$zipPath" |
            Out-File `
              -FilePath $env:GITHUB_ENV `
              -Append

      - name: Generate SHA-256
        shell: pwsh
        run: |
          $hash = Get-FileHash `
            -Path "$env:ZIP_PATH" `
            -Algorithm SHA256

          $hash.Hash.ToLowerInvariant() |
            Out-File `
              -FilePath "$env:ZIP_PATH.sha256" `
              -Encoding ascii `
              -NoNewline

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          generate_release_notes: true
          files: |
            ${{ env.ZIP_PATH }}
            ${{ env.ZIP_PATH }}.sha256
