                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
