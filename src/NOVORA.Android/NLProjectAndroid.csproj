<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NOVORA.AndroidApp</RootNamespace>
    <ApplicationId>com.novora.appcontrol</ApplicationId>
    <ApplicationVersion>50</ApplicationVersion>
    <ApplicationDisplayVersion>1.4.50</ApplicationDisplayVersion>
    <ApplicationTitle>NOVORA-LINK</ApplicationTitle>
    <AndroidManifest>Properties\NLPropertiesAndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidBuildApplicationPackage>false</AndroidBuildApplicationPackage>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!-- Evita el cierre de Mono observado en el Samsung ARM64 con AOT. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Registro JNI dinámico: evita UnsatisfiedLinkError en MainActivity.n_onCreate. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\NOVORA\Control\NLControlProtocol.cs" Link="Control\NLControlProtocol.cs" />
    <Compile Include="..\NOVORA\Control\NLControlInputLoop.cs" Link="Control\NLControlInputLoop.cs" />
    <Compile Include="..\NOVORA\Control\NLControlAndroidInput.cs" Link="Control\NLControlAndroidInput.cs" />
    <Compile Include="..\NOVORA\Control\NLControlVideoSize.cs" Link="Control\NLControlVideoSize.cs" />
    <Compile Include="..\NOVORA\Control\NLControlPointerGeometry.cs" Link="Control\NLControlPointerGeometry.cs" />
    <Compile Include="..\NOVORA\Control\NLControlClient.cs" Link="Control\NLControlClient.cs" />
    <Compile Include="..\NOVORA\VisionEngine\Protocol\VEProtocolCodec.cs" Link="VisionEngine\Protocol\VEProtocolCodec.cs" />
    <Compile Include="..\NOVORA\VisionEngine\Protocol\VEProtocolConstants.cs" Link="VisionEngine\Protocol\VEProtocolConstants.cs" />
    <Compile Include="..\NOVORA\VisionEngine\Protocol\VEProtocolExtensions.cs" Link="VisionEngine\Protocol\VEProtocolExtensions.cs" />
    <Compile Include="..\NOVORA\VisionEngine\Protocol\VEProtocolSession.cs" Link="VisionEngine\Protocol\VEProtocolSession.cs" />
    <Compile Include="..\NOVORA\VisionEngine\Protocol\VEProtocolWriter.cs" Link="VisionEngine\Protocol\VEProtocolWriter.cs" />
    <AndroidResource Include="..\NOVORA\Asset\NLAssetNovoraLogo.png" Link="Resources\drawable\novora_logo.png" />
    <AndroidResource Include="..\NOVORA\Asset\NLAssetBienvenido.png" Link="Resources\drawable\novora_welcome.png" />
    <AndroidResource Include="AndroidResource\NLAndroidResourceAccessibility.xml" Link="Resources\xml\novora_accessibility.xml" />
    <AndroidResource Include="AndroidResource\NLAndroidResourceInputMethod.xml" Link="Resources\xml\novora_input_method.xml" />
  </ItemGroup>
  <Target Name="NovoraRequireExplicitPackaging" BeforeTargets="_CreateBaseApk;_BuildApkEmbed;_BuildApkFastDev;SignAndroidPackage">
    <Error Condition="'$(NovoraPackage)' != 'true'" Text="NOVORA no empaqueta automáticamente. Valida con -t:Compile; para una prueba instalada usa -p:NovoraPackage=true explícitamente." />
  </Target>
  <ItemGroup><Compile Include="..\NOVORA\Control\NLControlLanInvitation.cs" Link="Control\NLControlLanInvitation.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\NOVORA\Control\NLControlLanDiscovery.cs" Link="Control\NLControlLanDiscovery.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\NOVORA\Control\NLControlSession.cs" Link="Control\NLControlSession.cs" /></ItemGroup>
  <ItemGroup><AndroidResource Include="AndroidResource\NLAndroidResourceNotification.xml" Link="Resources\drawable\novora_notification.xml" /></ItemGroup>
  <ItemGroup><Compile Include="..\NOVORA\Control\NLControlTrustedPc.cs" Link="Control\NLControlTrustedPc.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\NOVORA\Control\NLControlVpnProtocol.cs" Link="Control\NLControlVpnProtocol.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\NOVORA\Control\NLControlFile*.cs" Link="Control\%(Filename)%(Extension)" /></ItemGroup>
</Project>
