<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@color/surface_container_low">
    <ImageView android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1"
        android:src="@drawable/novora_wordmark" android:contentDescription="@string/brand_logo"
        android:scaleType="fitStart" android:adjustViewBounds="true" />
    <TextView android:id="@+id/connection_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/connection_type" style="@style/StatusBadge" />
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/files_title" style="@style/SectionTitle" />
        <TextView android:id="@+id/files_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sin conexión" style="@style/StatusBadge" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/button_received" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recibidos (4)" style="@style/SecondaryButton" />
        <Button android:id="@+id/button_sent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Enviados (12)" style="@style/SecondaryButton" android:layout_marginStart="6dp" />
        <Button android:id="@+id/button_send_pc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Enviar a PC" style="@style/PrimaryButton" android:layout_marginStart="6dp" />
      </LinearLayout>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_subtle_card" android:layout_marginTop="12dp">
        <TextView android:id="@+id/transfer_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin transferencia activa" style="@style/CardTitle" />
        <TextView android:id="@+id/transfer_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOVORA PC informará cuando exista una transferencia." style="@style/BodySmall" android:layout_marginTop="4dp" />
        <ProgressBar android:id="@+id/progress_transfer" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/bg_progress" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin progreso reportado" style="@style/BodySmall" android:layout_marginTop="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
          <Button android:id="@+id/button_pause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pausar" style="@style/SecondaryButton" />
          <Button android:id="@+id/button_cancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cancelar" style="@style/SecondaryButton" android:layout_marginStart="8dp" />
        </LinearLayout>
      </LinearLayout>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_subtle_card" android:layout_marginTop="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Completados recientes" style="@style/SectionTitle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOVORA PC no reporta historial en el snapshot actual." style="@style/CardTitle" android:lineSpacingExtra="4dp" android:layout_marginTop="10dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_variant" android:layout_marginVertical="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Los archivos aparecerán cuando el protocolo publique esa información." style="@style/BodySmall" />
      </LinearLayout>

      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/media_title" style="@style/SectionTitle" android:layout_marginTop="22dp" android:layout_marginBottom="10dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_subtle_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="♫  Enrutamiento de sonido" style="@style/CardTitle" />
        <TextView android:id="@+id/audio_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin datos de audio" style="@style/BodySmall" android:lineSpacingExtra="5dp" android:layout_marginTop="4dp" />
        <RadioGroup android:id="@+id/audio_route_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
          <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Solo teléfono" android:textSize="11sp" />
          <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Teléfono ↔ PC" android:textSize="11sp" android:checked="true" />
          <RadioButton android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Independiente" android:textSize="11sp" />
        </RadioGroup>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/button_record" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="■ Detener grabación\n00:14:32" style="@style/SecondaryButton" />
        <Button android:id="@+id/button_capture" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Captura rápida\nCapturar" style="@style/PrimaryButton" android:layout_marginStart="8dp" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="@color/surface_container_lowest" android:gravity="center">
    <Button android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/nav_home" android:textColor="@color/on_surface_variant" android:background="@color/transparent" />
    <Button android:id="@+id/nav_engines" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/nav_engines" android:textColor="@color/on_surface_variant" android:background="@color/transparent" />
    <Button android:id="@+id/nav_files" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/nav_files" android:textColor="@color/primary" android:background="@color/secondary_container" />
  </LinearLayout>
</LinearLayout>
