<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/primary</item>
    <item name="android:navigationBarColor">@color/surface_container_lowest</item>
    <item name="android:statusBarColor">@color/surface_container_low</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowActionModeOverlay">true</item>
  </style>
  <style name="SectionTitle">
    <item name="android:textColor">@color/on_surface_variant</item>
    <item name="android:textSize">11sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0.08</item>
    <item name="android:textAllCaps">true</item>
  </style>
  <style name="CardTitle">
    <item name="android:textColor">@color/on_surface</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="BodySmall">
    <item name="android:textColor">@color/on_surface_variant</item>
    <item name="android:textSize">12sp</item>
  </style>
  <style name="StatusBadge">
    <item name="android:background">@drawable/bg_status</item>
    <item name="android:textColor">@color/primary</item>
    <item name="android:textSize">11sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:paddingLeft">10dp</item>
    <item name="android:paddingRight">10dp</item>
    <item name="android:paddingTop">5dp</item>
    <item name="android:paddingBottom">5dp</item>
  </style>
  <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
    <item name="android:background">@drawable/bg_primary_button</item>
    <item name="android:textColor">@color/on_primary</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:minHeight">40dp</item>
  </style>
  <style name="SecondaryButton" parent="android:style/Widget.Material.Button">
    <item name="android:background">@drawable/bg_secondary_button</item>
    <item name="android:textColor">@color/primary</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:minHeight">40dp</item>
  </style>
</resources>
