<Window
    x:Class="NOVORA.NLUIWindowSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuración - NOVORA-LINK 1.4"
    Width="820"
    Height="700"
    MinWidth="760"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource WindowBrush}"
    Closing="SettingsWindow_Closing">

    <Window.Resources>
        <Style x:Key="SettingsSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="BlueCardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TitleSurfaceTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="BlueCardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TitleSurfaceAccentBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SettingsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border
        Background="{DynamicResource WindowBrush}"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="22">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- ENCABEZADO + TEMA                                 -->
            <!-- ================================================= -->

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        Text="CONFIGURA TU NOVORA"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock
                        Text="Apariencia, salida de video y audio de VisionEngine"
                        Margin="0,5,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="TEMA"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource BlueBrush}"/>

                    <ComboBox
                        Grid.Column="1"
                        Style="{StaticResource SettingsCombo}"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Value"
                        SelectionChanged="Theme_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Label}"
                                    Foreground="{DynamicResource InputForegroundBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>

            <!-- ================================================= -->
            <!-- CONTENIDO                                         -->
            <!-- ================================================= -->

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- CAPACIDADES -->

                    <TextBlock
                        Text="CAPACIDADES DEL TELÉFONO"
                        Style="{StaticResource SettingsSectionLabel}"/>

                    <Border
                        Background="{DynamicResource TitleBarBrush}"
                        BorderBrush="{DynamicResource WindowBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="8,0,18,0">
                                <TextBlock Text="RESOLUCIÓN MÁX." Style="{StaticResource BlueCardCaption}"/>
                                <TextBlock
                                    Text="{Binding DeviceNativeResolutionLabel, Mode=OneWay}"
                                    Margin="0,6,0,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TitleSurfaceTextBrush}"/>
                                <TextBlock
                                    Text="NATIVA"
                                    Margin="0,3,0,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource TitleSurfaceAccentBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#6C879A"/>

                            <StackPanel Grid.Column="2" Margin="18,0">
                                <TextBlock Text="FPS MÁXIMOS" Style="{StaticResource BlueCardCaption}"/>
                                <TextBlock
                                    Text="{Binding DeviceMaxFpsLabel, Mode=OneWay}"
                                    Margin="0,6,0,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TitleSurfaceTextBrush}"/>
                                <TextBlock
                                    Text="NATIVOS"
                                    Margin="0,3,0,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource TitleSurfaceAccentBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#6C879A"/>

                            <StackPanel Grid.Column="4" Margin="18,0,8,0">
                                <TextBlock Text="HZ MÁXIMOS" Style="{StaticResource BlueCardCaption}"/>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TitleSurfaceTextBrush}"
                                    Text="{Binding DeviceMaxRefreshRateLabel, Mode=OneWay}"/>
                                <TextBlock
                                    Text="NATIVOS"
                                    Margin="0,3,0,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource TitleSurfaceAccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SALIDA DE VIDEO -->

                    <TextBlock
                        Text="SALIDA DE VIDEO"
                        Style="{StaticResource SettingsSectionLabel}"/>

                    <Border
                        Background="{DynamicResource TitleBarBrush}"
                        BorderBrush="{DynamicResource WindowBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- MODO -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,12" VerticalAlignment="Center">
                                <TextBlock Text="Modo" Style="{StaticResource BlueCardTitle}"/>
                                <TextBlock Text="Ventana o pantalla completa" Style="{StaticResource BlueCardCaption}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,12"
                                Style="{StaticResource SettingsCombo}"
                                ItemsSource="{Binding VideoPresentationModeOptions}"
                                SelectedValue="{Binding VideoPresentationMode, Mode=TwoWay}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- MONITOR -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,18,12" VerticalAlignment="Center">
                                <TextBlock Text="Monitor" Style="{StaticResource BlueCardTitle}"/>
                                <TextBlock Text="Pantalla donde abrir VisionEngine" Style="{StaticResource BlueCardCaption}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,12"
                                Style="{StaticResource SettingsCombo}"
                                ItemsSource="{Binding Monitors}"
                                SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding DisplayLabel}"
                                            Foreground="{DynamicResource InputForegroundBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding IdentityDescription}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- CALIDAD -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,18,12" VerticalAlignment="Center">
                                <TextBlock Text="Calidad de transmisión" Style="{StaticResource BlueCardTitle}"/>
                                <TextBlock Text="Tasa de bits de video" Style="{StaticResource BlueCardCaption}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,0,0,12"
                                Style="{StaticResource SettingsCombo}"
                                ItemsSource="{Binding BitrateOptions}"
                                SelectedValue="{Binding Bitrate, Mode=TwoWay}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- FPS -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,18,12" VerticalAlignment="Center">
                                <TextBlock Text="FPS" Style="{StaticResource BlueCardTitle}"/>
                                <TextBlock Text="Hasta el máximo nativo" Style="{StaticResource BlueCardCaption}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <ComboBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,0,0,12"
                                Style="{StaticResource SettingsCombo}"
                                ItemsSource="{Binding FpsOptions}"
                                SelectedValue="{Binding TargetFps, Mode=TwoWay}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- RESOLUCION -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,18,12" VerticalAlignment="Center">
                                <TextBlock Text="Resolución" Style="{StaticResource BlueCardTitle}"/>
                                <TextBlock Text="Hasta la resolución nativa" Style="{StaticResource BlueCardCaption}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <ComboBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,0,0,12"
                                Style="{StaticResource SettingsCombo}"
                                ItemsSource="{Binding ResolutionOptions}"
                                SelectedValue="{Binding MaxSize, Mode=TwoWay}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- AUDIO -->
                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="Audio" Style="{StaticResource BlueCardTitle}"/>
                                <TextBlock Text="Salida de audio de la computadora" Style="{StaticResource BlueCardCaption}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <ComboBox
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource SettingsCombo}"
                                ItemsSource="{Binding AudioOutputOptions}"
                                SelectedValue="{Binding SelectedAudioOutput, Mode=TwoWay}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding Label}"
                                            Foreground="{DynamicResource InputForegroundBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <!-- DESCRIPCION -->

                    <TextBlock
                        Text="DESCRIPCIÓN"
                        Style="{StaticResource SettingsSectionLabel}"/>

                    <Border
                        Background="{DynamicResource TitleBarBrush}"
                        BorderBrush="{DynamicResource WindowBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="4,0,20,0">
                                <TextBlock
                                    Text="LINKENGINE"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TitleSurfaceAccentBrush}"/>
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Text="Motor de conectividad de NOVORA-LINK. Gestiona Internet USB, VPN, transporte, estado de sesión y recuperación de la conexión Android."
                                    FontSize="11"
                                    Foreground="{DynamicResource TitleSurfaceMutedBrush}"
                                    TextWrapping="Wrap"
                                    LineHeight="17"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#6C879A"/>

                            <StackPanel Grid.Column="2" Margin="20,0,4,0">
                                <TextBlock
                                    Text="VISIONENGINE"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TitleSurfaceAccentBrush}"/>
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Text="Motor de video, audio y control remoto. Muestra la pantalla Android mediante la salida de video seleccionada en esta ventana."
                                    FontSize="11"
                                    Foreground="{DynamicResource TitleSurfaceMutedBrush}"
                                    TextWrapping="Wrap"
                                    LineHeight="17"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================= -->
            <!-- PIE                                               -->
            <!-- ================================================= -->

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Los cambios se aplicarán al guardar."
                    FontSize="11"
                    Foreground="{DynamicResource MutedBrush}"
                    VerticalAlignment="Center"/>

                <CheckBox
                    x:Name="StartWithWindowsCheckBox"
                    Grid.Column="1"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    IsChecked="True"
                    Content="Iniciar con Windows"
                    Foreground="{DynamicResource TextBrush}"
                    ToolTip="Iniciar NOVORA automáticamente 5 segundos después de entrar a Windows"/>

                <Button
                    Grid.Column="2"
                    Content="Guardar cambios"
                    Width="150"
                    Height="42"
                    Style="{StaticResource ActionButton}"
                    Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
