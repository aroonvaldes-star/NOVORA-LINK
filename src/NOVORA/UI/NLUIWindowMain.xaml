<Window
    x:Class="NOVORA.NLUIWindowMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NOVORA-LINK 1.4"
    Width="1080"
    Height="700"
    MinWidth="940"
    MinHeight="610"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="{DynamicResource WindowBrush}"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="NvCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="NvWindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D506F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0B2B45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BlueDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvFlatButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush2}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource InputSelectedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter Margin="2,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>

        <Style x:Key="NvPageTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="NvSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NvCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="NvMetricProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="NvBatteryProgressStyle" TargetType="ProgressBar">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="118"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="ShellRoot14" Loaded="ShellRoot_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="286"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image
                           Source="Asset/NLAssetNOVORABRAND.png"
                           Width="266"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,-6,0,0"
                           IsHitTestVisible="False"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0" Height="0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" Height="34">
                        <Button Content="—" Style="{StaticResource NvWindowButtonStyle}" Click="Minimize_Click" ToolTip="Minimizar"/>
                        <Button Content="✕" Style="{StaticResource NvWindowButtonStyle}" Click="Close_Click" ToolTip="Cerrar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- EVENT / UPDATE MESSAGE BAR. No polling. -->
            <Border x:Name="TopMessageBorder14"
                    Grid.Row="1"
                    Background="{DynamicResource PanelBrush2}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="TopMessageDot14"
                             Width="9" Height="9"
                             Fill="{DynamicResource GreenBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TopMessageText14"
                               Grid.Column="1"
                               Text="NOVORA listo."
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="UpdateBannerActionButton14"
                            Grid.Column="2"
                            Content="INSTALAR"
                            Visibility="Collapsed"
                            Height="30"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource NvFlatButtonStyle}"
                            Click="InstallUpdateBanner_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="10,12,10,0">
                            <Button x:Name="NavHome14" Tag="Home" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌂" FontSize="20" Width="34"/>
                                    <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavScreen14" Tag="Screen" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▣" FontSize="18" Width="34"/>
                                    <TextBlock Text="Pantalla" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavNetwork14" Tag="Network" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◉" FontSize="18" Width="34"/>
                                    <TextBlock Text="Red" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavPerformance14" Tag="Performance" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="17" Width="34"/>
                                    <TextBlock Text="Rendimiento" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavGameInput14" Tag="GameInput" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎮" FontSize="16" Width="34"/>
                                    <TextBlock Text="Game Input" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavIntegration14" Tag="Integration" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↔" FontSize="20" Width="34"/>
                                    <TextBlock Text="Integración" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavPrivacy14" Tag="Privacy" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◆" FontSize="18" Width="34"/>
                                    <TextBlock Text="Privacidad" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="10,0,10,12">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0,8,8"/>
                            <Button x:Name="NavSettings14" Tag="Settings" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="18" Width="34"/>
                                    <TextBlock Text="Configuración" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAGE HOST -->
                <Grid x:Name="PageHost14" Grid.Column="1" Margin="22,18,22,22" ClipToBounds="True">

                    <!-- HOME -->
                    <ScrollViewer x:Name="HomePage14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Instala NOVORA en tu Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="La app permite controlar NOVORA PC, cambiar sus ajustes y usar Internet de PC por USB. Conecta tu teléfono por USB y autoriza la depuración USB en su pantalla. NOVORA comprobará la versión antes de instalar o actualizar la misma app." Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="AndroidInstallButton" Content="INSTALAR NOVORA POR USB" IsEnabled="False" Click="InstallAndroidApp_Click" Style="{StaticResource NvPrimaryButtonStyle}" Margin="0,0,10,0"/>
                                        <Button x:Name="AndroidInstallRefreshButton" Content="COMPROBAR APP" Click="RefreshAndroidInstallation_Click" Style="{StaticResource NvFlatButtonStyle}"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="AndroidInstallStatus" Text="Selecciona el teléfono USB para comprobar su app." Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="NOVORA Android · USB y LAN" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="Controla los motores, bitrate, perfil y audio. Conecta por USB o prepara una invitación LAN y escanea su QR. Para Internet USB, inicia LinkEngine desde Android y autoriza su VPN." Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                                    <WrapPanel>
                                        <Button Content="PREPARAR CONTROL USB" Click="PrepareAndroidControl_Click" Style="{StaticResource NvPrimaryButtonStyle}" Margin="0,0,10,0"/>
                                        <Button Content="PREPARAR LAN / QR" Click="PrepareAndroidLan_Click" Style="{StaticResource NvPrimaryButtonStyle}" Margin="0,0,10,0"/>
                                        <Button Content="TELÉFONOS AUTORIZADOS" Click="ManageAndroidTrust_Click" Style="{StaticResource NvFlatButtonStyle}" Margin="0,0,10,0"/>
                                        <Button Content="ACTIVAR RECONEXIÓN LAN" Click="ActivateAndroidTrust_Click" Style="{StaticResource NvFlatButtonStyle}" Margin="0,0,10,0"/>
                                        <Button Content="DETENER CONTROL" Click="StopAndroidControl_Click" Style="{StaticResource NvFlatButtonStyle}"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="AndroidControlStatus" Text="Control detenido." Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Dispositivo" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox x:Name="DeviceComboBox14"
                                                  ItemsSource="{Binding Devices}"
                                                  SelectedItem="{Binding Device, Mode=TwoWay}"
                                                  SelectionChanged="Device_SelectionChanged"
                                                  Style="{StaticResource NvComboStyle}"
                                                  Margin="0,10,0,7">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FriendlyName}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource NvCaptionStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="MainActionButton"
                                            Grid.Column="1"
                                            Content="▶ INICIAR"
                                            Style="{StaticResource NvPrimaryButtonStyle}"
                                            Click="MainActionButton_Click"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="VisionEngine" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Pantalla, audio, control, gamepad, clipboard y transferencia."
                                                   Style="{StaticResource NvCaptionStyle}" Margin="0,5,0,10"/>
                                        <TextBlock Text="{Binding OutputSummary}" Foreground="{DynamicResource BlueBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LinkEngine" Style="{StaticResource NvSectionTitleStyle}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Foreground, ElementName=LinkEngineFriendlyConnectionStatus}"/>
                                            <TextBlock x:Name="HomeLinkEngineState14"
                                                       Text="{Binding Text, ElementName=LinkEngineFriendlyConnectionStatus}"
                                                       Foreground="{Binding Foreground, ElementName=LinkEngineFriendlyConnectionStatus}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock x:Name="HomeLinkEngineDetail14"
                                                   Text="{Binding Text, ElementName=LinkEngineFriendlyUsbStatus}"
                                                   Style="{StaticResource NvCaptionStyle}"
                                                   Margin="17,2,0,10"
                                                   TextWrapping="Wrap"/>

                                        <Button Content="INTERNET POR USB"
                                                Style="{StaticResource NvFlatButtonStyle}"
                                                IsEnabled="False"
                                                Margin="0,0,0,7"/>

                                        <Button Content="ADB POR WI-FI"
                                                Style="{StaticResource NvFlatButtonStyle}"
                                                Click="WifiAdb_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SCREEN / VISIONENGINE SETTINGS -->
                    <ScrollViewer x:Name="ScreenPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Pantalla y VisionEngine" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Todas las opciones de salida que antes vivían en Configuración están aquí."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>

                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Modo" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding VideoPresentationModeOptions}"
                                                  SelectedValue="{Binding VideoPresentationMode, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Monitor" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding Monitors}"
                                                  SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellMonitor_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayLabel}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Salida de audio" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding AudioOutputOptions}"
                                                  SelectedValue="{Binding SelectedAudioOutput, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Calidad / bitrate" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding BitrateOptions}"
                                                  SelectedValue="{Binding Bitrate, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="FPS" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding FpsOptions}"
                                                  SelectedValue="{Binding TargetFps, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Resolución" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                                  SelectedValue="{Binding MaxSize, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource NvCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Perfil calculado" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="{Binding OutputSummary}" Foreground="{DynamicResource BlueBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,12" TextWrapping="Wrap"/>
                                    <Button Content="GUARDAR SALIDA DE VIDEO" Style="{StaticResource NvPrimaryButtonStyle}" HorizontalAlignment="Left" Click="SaveShellSettings_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- NETWORK -->
                    <ScrollViewer x:Name="NetworkPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Red y LinkEngine" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="VPN, Internet USB, ADB Wi‑Fi, CONTROL/DATA, Remote y Recovery."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Estado de LinkEngine" Style="{StaticResource NvSectionTitleStyle}" Margin="0,0,0,12"/>
                                        <Grid Grid.Row="1" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Resultado" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="LinkEngineResultStatus" Grid.Column="1" Text="Detenido" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Dispositivo / ADB" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="LinkEngineDeviceStatus" Grid.Column="1" Text="ADB: -" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                        <Grid Grid.Row="3" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Canal Android" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="LinkEngineClientStatus" Grid.Column="1" Text="Android: -" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                        <Grid Grid.Row="4" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Recovery / protocolo" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="LinkEngineProtocolStatus" Grid.Column="1" Text="# 0" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                        <Grid Grid.Row="5" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Transporte" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="LinkEngineTransportStatus" Grid.Column="1" Text="-" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Button x:Name="LinkEngineTestButton" Content="INTERNET USB" Style="{StaticResource NvPrimaryButtonStyle}" IsEnabled="False" Margin="0,0,0,10"/>
                                    <Button x:Name="WifiAdbButton" Content="ADB POR WI‑FI" Style="{StaticResource NvFlatButtonStyle}" Click="WifiAdb_Click" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource NvCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Remote Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                            <TextBlock Text="Canal remoto local de NOVORA. Se configura con el Android seleccionado y no inicia los motores por sí solo."
                                                       Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PERFORMANCE -->
                    <ScrollViewer x:Name="PerformancePage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Rendimiento" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Las métricas de dispositivo se consultan bajo demanda/eventos; la UI no crea un timer de sondeo."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Batería" Style="{StaticResource NvSectionTitleStyle}" HorizontalAlignment="Center"/>
                                        <ProgressBar x:Name="BatteryProgress14" Minimum="0" Maximum="100" Value="0" Style="{StaticResource NvBatteryProgressStyle}" Margin="0,14,0,8"/>
                                        <TextBlock x:Name="BatteryPercentText14" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="CpuValueText14" Text="--" Foreground="{DynamicResource BlueBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <ProgressBar x:Name="CpuProgress14" Minimum="0" Maximum="100" Value="0" Style="{StaticResource NvMetricProgressStyle}" Margin="0,4,0,14"/>
                                        <TextBlock Text="RAM" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="RamValueText14" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <ProgressBar x:Name="RamProgress14" Minimum="0" Maximum="100" Value="0" Style="{StaticResource NvMetricProgressStyle}" Margin="0,4,0,14"/>
                                        <TextBlock Text="Temperatura" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="TemperatureValueText14" Text="--" Foreground="{DynamicResource CyanBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <ProgressBar x:Name="TemperatureProgress14" Minimum="0" Maximum="100" Value="0" Style="{StaticResource NvMetricProgressStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="NVIDIA / VisionEngine" Style="{StaticResource NvSectionTitleStyle}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,2">
                                            <Ellipse x:Name="NvidiaStatusDot14"
                                                     Width="9"
                                                     Height="9"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="NvidiaStatusTitle14"
                                                       Text="NVIDIA aún no evaluado."
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>

                                        <TextBlock x:Name="NvidiaCapabilitiesText14"
                                                   Text="CUDA: - · NVDEC: - · NVENC: -"
                                                   Style="{StaticResource NvCaptionStyle}"
                                                   Margin="17,3,0,0"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock x:Name="NvidiaBackendText14"
                                                   Text="Backend: FFmpeg"
                                                   Style="{StaticResource NvCaptionStyle}"
                                                   Margin="17,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Perfil NVIDIA" Style="{StaticResource NvSectionTitleStyle}"/>

                                        <ComboBox x:Name="NvidiaProfileCombo14"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding NvidiaProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource NvComboStyle}"
                                                  Margin="0,8,0,0"
                                                  SelectionChanged="NvidiaProfile_SelectionChanged14">
                                            <ComboBoxItem Tag="Automatic" Content="Automático"/>
                                            <ComboBoxItem Tag="Disabled" Content="Desactivado"/>
                                            <ComboBoxItem Tag="Competitive" Content="Competitivo"/>
                                            <ComboBoxItem Tag="Balanced" Content="Equilibrado"/>
                                            <ComboBoxItem Tag="VisionPlus" Content="VisionPlus"/>
                                            <ComboBoxItem Tag="Smooth" Content="Smooth"/>
                                            <ComboBoxItem Tag="Stream" Content="Stream"/>
                                        </ComboBox>

                                        <TextBlock Text="Por ahora, los perfiles NVIDIA habilitados comparten los mismos ajustes. No añaden interpolación ni mejoras de imagen."
                                                   Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="NvidiaPipelineText14"
                                                   Text="Pipeline: FFmpeg"
                                                   Style="{StaticResource NvCaptionStyle}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Aplicar perfil de video VE" Style="{StaticResource NvSectionTitleStyle}" Margin="0,14,0,0"/>
                                        <ComboBox x:Name="VideoProfileCombo14" Style="{StaticResource NvComboStyle}" Margin="0,8,0,0"
                                                  SelectionChanged="VideoProfile_SelectionChanged14">
                                            <ComboBoxItem Tag="Gaming" Content="Juego · 4M · 1280 · 45 FPS"/>
                                            <ComboBoxItem Tag="Balanced" Content="Equilibrado · 5M · 1280 · 45 FPS"/>
                                            <ComboBoxItem Tag="Video" Content="Video · 6M · 1600 · 45 FPS"/>
                                            <ComboBoxItem Tag="Battery" Content="Ahorro · 3M · 960 · 30 FPS"/>
                                        </ComboBox>
                                        <TextBlock Text="Rellena las opciones de video. Se aplican al iniciar o reconectar la transmisión."
                                                   Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="STEngine" Style="{StaticResource NvSectionTitleStyle}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,2">
                                        <Ellipse x:Name="STEngineStatusDot14"
                                                 Width="9"
                                                 Height="9"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="STEngineStatusTitle14"
                                                   Text="STEngine esperando datos."
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock x:Name="STEngineStatusText14"
                                               Text="El motor de medicion se activa con VisionEngine."
                                               Style="{StaticResource NvCaptionStyle}"
                                               Margin="17,4,0,0"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="STEngineObservationsText14"
                                               Text=""
                                               Style="{StaticResource NvCaptionStyle}"
                                               Margin="17,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Optimización segura del dispositivo" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="DeviceFastPerformanceStatusText" Text="Lista para analizar y optimizar cuando tú lo solicites." Style="{StaticResource NvCaptionStyle}" Margin="0,6,14,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="OPTIMIZAR AHORA" Style="{StaticResource NvPrimaryButtonStyle}" Click="DeviceFastPerformanceButton_Click"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="_performanceStatus" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- GAME INPUT -->
                    <ScrollViewer x:Name="GameInputPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Game Input" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Control físico → SDL3 → UHID → Android, integrado a VisionEngine y protegido por PrivacyVE."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Estado de GamepadVE" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock x:Name="GamepadStatusText14" Text="Gamepad VisionEngine detenido." Foreground="{DynamicResource TextBrush}" FontSize="15" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="GamepadCountText14" Text="Mandos conectados: 0" Style="{StaticResource NvCaptionStyle}"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Compatibilidad actual" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Xbox / XInput compatible mediante SDL3 y dispositivo UHID." Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,4"/>
                                        <TextBlock Text="DualShock / DualSense entran por la capa SDL cuando el backend los expone como gamepad." Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Política" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Event-driven: no hay lectura periódica de botones. Privacy Shield neutraliza el estado enviado a Android." Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- INTEGRATION -->
                    <ScrollViewer x:Name="IntegrationPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Integración Android ↔ Windows" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Funciones que hacen que Android se comporte como una extensión de NOVORA."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Capacidades activas" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock x:Name="IntegrationStatusText14" Text="Clipboard · archivos · Drag &amp; Drop" Foreground="{DynamicResource TextBrush}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="2" Rows="3">
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,0,7,7">
                                    <StackPanel>
                                        <TextBlock Text="Clipboard" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Android ↔ Windows por eventos, sin historial sensible." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,0,0,7">
                                    <StackPanel>
                                        <TextBlock Text="Archivos / Share" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Envío y recepción explícitos; Drag &amp; Drop disponible en la ventana de VisionEngine." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,7,7,7">
                                    <StackPanel>
                                        <TextBlock Text="Apps y notificaciones" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Infraestructura IntegrationVE presente; algunas capacidades dependen del backend Android." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,7,0,7">
                                    <StackPanel>
                                        <TextBlock Text="Display / ventanas" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Virtual display, resize y ventanas se exponen sólo cuando la capacidad está disponible." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,7,7,0">
                                    <StackPanel>
                                        <TextBlock Text="Micrófono Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Capacidad Android → PC disponible en la arquitectura actual." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,7,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Cámara / PC → Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Se muestran como capacidad cuando el backend real las soporte; no se simulan funciones inexistentes." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PRIVACY -->
                    <ScrollViewer x:Name="PrivacyPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Privacidad" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="PrivacyVE protege video, audio, control, gamepad, clipboard y transferencias sin romper la sesión."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Privacy Shield" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="PrivacyStatusText14" Text="PrivacyVE listo." Foreground="{DynamicResource TextBrush}" FontSize="15" Margin="0,8,14,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ManualPrivacyButton14" Grid.Column="1" Content="ACTIVAR MANUAL" Style="{StaticResource NvPrimaryButtonStyle}" Click="ManualPrivacy_Click"/>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Protección automática" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="System Secure respeta contenido protegido por Android. Sensitive NLApplicationApp y Secure Input activan la compuerta sin leer contraseñas ni URLs." Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Qué bloquea" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Video visible · audio nuevo · teclado/mouse · gamepad · clipboard · File/Image/Media · grabación futura." Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SETTINGS -->
                    <ScrollViewer x:Name="SettingsPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configuración" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Sólo opciones globales. Pantalla, red, rendimiento y game input viven en sus propias secciones."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tema" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Cambia la apariencia de NOVORA en vivo." Style="{StaticResource NvCaptionStyle}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ThemeOptions}"
                                              SelectedValue="{Binding Theme, Mode=TwoWay}"
                                              SelectedValuePath="Value"
                                              Style="{StaticResource NvComboStyle}"
                                              SelectionChanged="ShellTheme_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Actualizaciones" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="NOVORA comprueba una vez al abrir la aplicación. Si existe una versión nueva, aparece en la barra superior. No se mantiene un sondeo periódico." Style="{StaticResource NvCaptionStyle}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="210"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Guardar preferencias" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Guarda tema, dispositivo, monitor, audio, modo, bitrate, FPS y resolución." Style="{StaticResource NvCaptionStyle}" Margin="0,5,14,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="GUARDAR" Style="{StaticResource NvPrimaryButtonStyle}" Click="SaveShellSettings_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!--
                Compatibility bridge.

                Existing partial classes still publish their state into these
                named controls. They are intentionally hidden because the new
                shell exposes the same state in Home/Network/Performance.

                IMPORTANT:
                This bridge does NOT add polling. It only preserves the
                existing event/state contracts.
            -->
            <Grid Visibility="Collapsed">
                <Button x:Name="RefreshDevicesButton"
                        Click="RefreshDevices_Click"/>

                <Ellipse x:Name="VisionEngineStatusDot14"
                         Width="1"
                         Height="1"/>

                <TextBlock x:Name="VisionEngineUiStatusText"/>

                <!-- LinkEngine contracts consumed by NLUIWindowMain.LinkEngineLE.cs -->
                <TextBlock x:Name="LinkEngineFriendlyConnectionStatus"
                           Text="INACTIVO"/>

                <TextBlock x:Name="LinkEngineFriendlyPhoneStatus"
                           Text="Sin dispositivo"/>

                <TextBlock x:Name="LinkEngineFriendlyUsbStatus"
                           Text="Internet USB detenido"/>

                <TextBlock x:Name="LinkEngineFriendlyRecoveryStatus"
                           Text="Recovery inactivo"/>

                <!-- VisionEngine contract consumed by NLUIWindowMain.VisionEngineVE.cs -->
                <TextBlock x:Name="EngineFeatureStatus14"
                           Text="VisionEngine detenido"/>
            </Grid>
        </Grid>
    </Border>
</Window>
