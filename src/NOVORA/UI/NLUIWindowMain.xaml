                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Lectura del mando" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="ExInAxesText14" Text="Sticks y gatillos sin datos" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Salud y batería" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="ExInHealthText14" Text="Diagnóstico no ejecutado" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
