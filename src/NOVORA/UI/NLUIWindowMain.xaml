<Window
    x:Class="NOVORA.NLUIWindowMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:NOVORA"
    mc:Ignorable="d"
    Title="NOVORA-LINK 1.4" Icon="/Asset/NOVORA_Win32.ico" FontFamily="{DynamicResource NovoraFontFamily}" FontSize="15"
    Width="1180"
    Height="800"
    MinWidth="1000"
    MinHeight="610"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="{DynamicResource WindowBrush}"
    Loaded="Window_Loaded"
    StateChanged="Window_StateChanged"
    Closing="Window_Closing">

    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
<ResourceDictionary Source="/NOVORA-LINK;component/Resource/NLResourceMainStyles.xaml"/>
</ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="ShellRoot14" Loaded="ShellRoot_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP TITLE BAR -->
            <Border x:Name="TitleBar14" Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="{DynamicResource NovoraTitleEmblemSource}"
                               Width="42" Height="42" Stretch="Uniform"/>
                        <Image Source="{DynamicResource NovoraTitleWordmarkSource}"
                               Width="153" Height="42" Margin="8,0,0,0" Stretch="Uniform"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" Height="44">
                        <Button Content="➖"
                                FontFamily="Segoe MDL2 Assets"
                                AutomationProperties.Name="Minimizar NOVORA"
                                ToolTip="Minimizar"
                                 Style="{StaticResource NvWindowButtonStyle}"
                                 Click="Minimize_Click"/>
                        <Button x:Name="MaximizeRestoreButton14"
                                Content="□"
                                AutomationProperties.Name="Maximizar NOVORA"
                                ToolTip="Maximizar"
                                Style="{StaticResource NvWindowButtonStyle}"
                                Click="MaximizeRestore_Click"/>
                        <Button Content="×"
                                 FontFamily="Segoe MDL2 Assets"
                                AutomationProperties.Name="Cerrar NOVORA"
                                ToolTip="Cerrar"
                                Style="{StaticResource NvWindowButtonStyle}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN ENGINES NAVIGATION -->
            <Border x:Name="TopNavigationBorder14" Grid.Row="1"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavHome14" Tag="Home" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}" MinWidth="112">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="20" Margin="0,0,8,0"/><TextBlock Text="Inicio" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavScreen14" Tag="Screen" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}" MinWidth="144">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="VisionEngine" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavNetwork14" Tag="Network" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}" MinWidth="144">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌁" FontSize="19" Margin="0,0,8,0"/><TextBlock Text="LinkEngine" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavGameInput14" Tag="GameInput" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}" MinWidth="144">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="ExInEngine" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavIntegration14" Tag="Integration" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}" MinWidth="150">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↔" FontSize="20" Margin="0,0,8,0"/><TextBlock Text="Integración" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSettings14" Tag="Settings" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}" MinWidth="164">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="17" Margin="0,0,8,0"/><TextBlock Text="Configuración" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- EVENT / UPDATE MESSAGE BAR. No polling. -->
            <Border x:Name="TopMessageBorder14"
                    Grid.Row="2"
                    Background="{DynamicResource PanelBrush2}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="TopMessageDot14"
                             Width="9" Height="9"
                             Fill="{DynamicResource GreenBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TopMessageText14"
                               Grid.Column="1"
                               Text="NOVORA listo."
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="UpdateBannerActionButton14"
                            Grid.Column="2"
                            Content="DESCARGAR ACTUALIZACIÓN"
                            Visibility="Collapsed"
                            Height="44"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource NvFlatButtonStyle}"
                            Click="InstallUpdateBanner_Click"/>
                </Grid>
            </Border>

            <!-- PAGE HOST -->
            <Grid x:Name="PageHost14" Grid.Row="3" Margin="22,18,22,22" ClipToBounds="True">

                    <!-- HOME -->
                    <ScrollViewer x:Name="HomePage14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="Inicio" Style="{StaticResource NvPageTitleStyle}" Margin="0,0,0,18"/><Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Conecta tu teléfono" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Usa un cable USB o conéctalo por Wi-Fi. Después podrás ver su pantalla en esta PC." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource NvCaptionStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DeviceDisplayName}" Foreground="{DynamicResource BlueBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="MainActionButton"
                                                Content="VER PANTALLA"
                                                Style="{StaticResource NvPrimaryButtonStyle}"
                                                Click="MainActionButton_Click"
                                                MinWidth="140"
                                                Height="42"
                                                ToolTip="Mostrar la pantalla del teléfono"/>
                                        <Button x:Name="HomeConnectionTypeButton"
                                                Content="TIPO DE CONEXIÓN ▾"
                                                Style="{StaticResource NvFlatButtonStyle}"
                                                Click="HomeConnectionTypeButton_Click"
                                                MinWidth="190"
                                                Height="42"
                                                Margin="10,0,0,0"
                                                ToolTip="Elige USB por cable o LAN por Wi-Fi para preparar la conexión">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem x:Name="HomeConnectionUsbOption" Header="USB · cable" IsCheckable="True" Click="HomeConnectionUsb_Click"/>
                                                    <MenuItem x:Name="HomeConnectionLanOption" Header="LAN · Wi-Fi" IsCheckable="True" Click="HomeConnectionLan_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border><UniformGrid Columns="3" Margin="0,8,0,0"><Border Style="{StaticResource NvCardStyle}" Margin="0,0,12,0"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Image Source="{DynamicResource NvVisionBrand}" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,16"/>
<TextBlock Grid.Row="1" Text="VisionEngine" Style="{StaticResource NvSectionTitleStyle}"/>
<TextBlock Grid.Row="2" Text="Transmisión de pantalla y audio" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,12"/>
<TextBlock Grid.Row="3" Text="{Binding Text, ElementName=VisionEngineUiStatusText}" Style="{StaticResource NvCaptionStyle}" Margin="0,0,0,20"/>
<Button Grid.Row="4" Tag="Screen" Content="{Binding Content, ElementName=MainActionButton}" Click="MainActionButton_Click" Style="{StaticResource NvPrimaryButtonStyle}" FontSize="14" MinWidth="0"/>
</Grid></Border><Border Style="{StaticResource NvCardStyle}" Margin="0,0,12,0"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Image Source="{DynamicResource NvLinkBrand}" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,16"/>
<TextBlock Grid.Row="1" Text="LinkEngine" Style="{StaticResource NvSectionTitleStyle}"/>
<TextBlock Grid.Row="2" Text="Internet y conexión de esta sesión" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,12"/>
<TextBlock Grid.Row="3" Text="{Binding Text, ElementName=LinkEngineResultStatus}" Style="{StaticResource NvCaptionStyle}" Margin="0,0,0,20"/>
<Button Grid.Row="4" Tag="Network" Content="Abrir LinkEngine" Click="HomeOpenSection_Click" Style="{StaticResource NvPrimaryButtonStyle}" FontSize="14" MinWidth="0"/>
</Grid></Border><Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,0"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Image Source="{DynamicResource NvExInBrand}" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,16"/>
<TextBlock Grid.Row="1" Text="ExInEngine" Style="{StaticResource NvSectionTitleStyle}"/>
<TextBlock Grid.Row="2" Text="Mando, entrada y calibración" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,12"/>
<TextBlock Grid.Row="3" Text="{Binding Text, ElementName=GamepadStatusText14}" Style="{StaticResource NvCaptionStyle}" Margin="0,0,0,20"/>
<Button Grid.Row="4" Tag="GameInput" Content="Abrir controles" Click="HomeOpenSection_Click" Style="{StaticResource NvPrimaryButtonStyle}" FontSize="14" MinWidth="0"/>
</Grid></Border></UniformGrid></StackPanel></ScrollViewer>

                    <!-- SCREEN / VISIONENGINE SETTINGS -->
                    <ScrollViewer x:Name="ScreenPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{DynamicResource NvVisionBrand}" Width="38" Height="38" Margin="0,0,12,0"/>
                                <TextBlock Text="VisionEngine · Pantalla y audio" Style="{StaticResource NvPageTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="Elige cómo ver y escuchar la pantalla del teléfono."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>

                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Estado de la pantalla" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="{Binding Text, ElementName=VisionEngineUiStatusText}"
                                                   Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding Content, ElementName=MainActionButton}"
                                            IsEnabled="{Binding IsEnabled, ElementName=MainActionButton}"
                                            Click="MainActionButton_Click" Style="{StaticResource NvPrimaryButtonStyle}"
                                            MinWidth="150" Height="42" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Perfil de transmisión" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="El perfil propone los valores de imagen y aceleración. Después puedes ajustar la calidad manualmente."
                                               Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                    <ComboBox x:Name="VisionProfileCombo14"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding VisionProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource NvComboStyle}"
                                                  Margin="0,8,0,0"
                                                  SelectionChanged="VisionProfile_SelectionChanged14">
                                                <ComboBoxItem Tag="Automatic" Content="Automático" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Tag="Competitive" Content="Competitivo" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Tag="Balanced" Content="Equilibrado" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Tag="Quality" Content="Calidad" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Tag="Smooth" Content="Fluidez" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Tag="Streaming" Content="Streaming" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Tag="Software" Content="Software" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                            </ComboBox>
                                    <TextBlock Text="El perfil se aplica al iniciar o reconectar la transmisión."
                                               Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Dónde ver y escuchar" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="Selecciona el monitor de la PC, la forma de abrir la imagen y la salida de audio."
                                               Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Monitor" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding Monitors}"
                                                  SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellMonitor_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayLabel}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                            <TextBlock Text="Presentación de la ventana" Style="{StaticResource NvSectionTitleStyle}" Margin="0,6,0,0"/>
                                            <ComboBox ItemsSource="{Binding VideoPresentationModeOptions}"
                                                  SelectedValue="{Binding VideoPresentationMode, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Salida de audio" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding AudioOutputOptions}"
                                                  SelectedValue="{Binding SelectedAudioOutput, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Expander Header="Ajustar calidad manualmente" Foreground="{DynamicResource TextBrush}" IsExpanded="False" Margin="0,0,0,14">
                                <Border Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Cambiar estos valores sustituye los sugeridos por el perfil. Se guardan para la siguiente transmisión."
                                                   Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"><TextBlock Text="Resolución" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                                  SelectedValue="{Binding MaxSize, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="FPS" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding FpsOptions}"
                                                  SelectedValue="{Binding TargetFps, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Calidad / bitrate" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding BitrateOptions}"
                                                  SelectedValue="{Binding Bitrate, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander Header="Opciones experimentales" Foreground="{DynamicResource TextBrush}" IsExpanded="False" Margin="0,0,0,14">
                                <Border Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="VisionDynamicPresentationCheck14"
                                                  Content="Presentación dinámica"
                                                  IsChecked="False" Foreground="{DynamicResource TextBrush}" FontSize="14"
                                                  Checked="VisionDynamicPresentation_Changed14"
                                                  Unchecked="VisionDynamicPresentation_Changed14" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ajusta la presentación al refresco de la pantalla. Puede cambiarse durante la sesión."
                                                   Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="VisionLatencyOptimizationCheck14"
                                                  Content="Optimización de latencia"
                                                  IsChecked="True" Foreground="{DynamicResource TextBrush}" FontSize="14"
                                                  Checked="VisionLatencyOptimization_Changed14"
                                                  Unchecked="VisionLatencyOptimization_Changed14" Margin="0,0,0,6"/>
                                        <TextBlock Text="Solicita decodificación de baja latencia al iniciar el video, sin cambiar resolución ni bitrate."
                                                   Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander Header="Diagnóstico técnico de VisionEngine" Foreground="{DynamicResource TextBrush}" IsExpanded="False" Margin="0,0,0,14">
                                <Border Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Aceleración disponible en esta PC" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,2">
                                            <Ellipse x:Name="NvidiaStatusDot14" Width="9" Height="9" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="NvidiaStatusTitle14" Text="Aceleración aún no evaluada."
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NvidiaCapabilitiesText14" Text="CUDA: - · NVDEC: - · NVENC: -"
                                                   Style="{StaticResource NvCaptionStyle}" Margin="17,3,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="NvidiaBackendText14" Text="Backend: FFmpeg"
                                                   Style="{StaticResource NvCaptionStyle}" Margin="17,3,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="NvidiaPipelineText14" Text="Pipeline: FFmpeg"
                                                   Style="{StaticResource NvCaptionStyle}" Margin="17,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="VisionTelemetryExpander14" Header="Mediciones en vivo" Foreground="{DynamicResource TextBrush}" IsExpanded="False"
                                      Margin="0,0,0,10" Expanded="VisionTelemetry_Changed14"
                                      Collapsed="VisionTelemetry_Changed14" IsVisibleChanged="VisionTelemetry_VisibilityChanged14">
                                <Border Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Se mide solo mientras este panel está abierto."
                                                   Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="VisionLiveTelemetryText14"
                                                   Text="Abre este panel para consultar las mediciones."
                                                   Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- NETWORK -->
                    <ScrollViewer x:Name="NetworkPage14"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><Image Source="{DynamicResource NvLinkBrand}" Width="38" Height="38" Margin="0,0,12,0"/><TextBlock Text="LinkEngine" Style="{StaticResource NvPageTitleStyle}"/></StackPanel>
                            <TextBlock Text="Conecta el teléfono a esta PC por USB o Wi-Fi."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Conexión" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="LinkEngineResultStatus"
                                                   Text="Conecta el teléfono para empezar."
                                                   Foreground="{DynamicResource BlueBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,14"
                                                   TextWrapping="Wrap"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                                                <TextBlock Text="Estado de LE" Style="{StaticResource NvCaptionStyle}"/>
                                                <TextBlock Text="{Binding Text, ElementName=LinkEngineFriendlyConnectionStatus}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                                <TextBlock Text="Teléfono" Style="{StaticResource NvCaptionStyle}"/>
