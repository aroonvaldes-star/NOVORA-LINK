                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- INTEGRATION -->
                    <ScrollViewer x:Name="IntegrationPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Integración Android ↔ Windows" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Funciones que hacen que Android se comporte como una extensión de NOVORA."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Archivos de esta sesión" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="El comparativo se actualiza cuando una transferencia termina correctamente."
                                               Style="{StaticResource NvCaptionStyle}"
                                               Margin="0,6,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Enviados al teléfono" Style="{StaticResource NvCaptionStyle}"/>
                                            <TextBlock x:Name="IntegrationFilesSentText14"
                                                       Text="0 archivos · 0 B"
                                                       Foreground="{DynamicResource BlueBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock x:Name="IntegrationFilesSentNames14" Text="Aún no hay archivos enviados."
                                                       Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
                                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                            <TextBlock Text="Recibidos en esta PC" Style="{StaticResource NvCaptionStyle}"/>
                                            <TextBlock x:Name="IntegrationFilesReceivedText14"
                                                       Text="0 archivos · 0 B"
                                                       Foreground="{DynamicResource GreenBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock x:Name="IntegrationFilesReceivedNames14" Text="Aún no hay archivos recibidos."
                                                       Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <UniformGrid Columns="2" Rows="3">
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,0,7,7">
                                    <StackPanel>
                                        <TextBlock Text="Clipboard" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Android ↔ Windows por eventos, sin historial sensible." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,0,0,7"
                                        AllowDrop="True"
                                        DragOver="IntegrationFiles_DragOver"
                                        Drop="IntegrationFiles_Drop">
                                    <StackPanel>
                                        <TextBlock Text="Archivos / Share" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Suelta aquí archivos o carpetas para enviarlos al teléfono." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,10"/>
                                        <Button Content="RECIBIR CARPETA NOVORA"
                                                Style="{StaticResource NvFlatButtonStyle}"
                                                Click="ReceiveNovoraFolder_Click"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,7,7,7">
                                    <StackPanel>
                                        <TextBlock Text="Apps y notificaciones" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Infraestructura IntegrationVE presente; algunas capacidades dependen del backend Android." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,7,0,7">
                                    <StackPanel>
                                        <TextBlock Text="Display / ventanas" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Virtual display, resize y ventanas se exponen sólo cuando la capacidad está disponible." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,7,7,0">
                                    <StackPanel>
                                        <TextBlock Text="Micrófono Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Capacidad Android → PC disponible en la arquitectura actual." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,7,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Cámara / PC → Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Se muestran como capacidad cuando el backend real las soporte; no se simulan funciones inexistentes." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PRIVACY -->
                    

                    <!-- SETTINGS -->
                    <ScrollViewer x:Name="SettingsPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configuración" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Sólo opciones globales. Pantalla, red, rendimiento y game input viven en sus propias secciones."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tema" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Inicio predeterminado: Light. Puedes activar Dark durante esta sesión." Style="{StaticResource NvCaptionStyle}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ThemeOptions}"
                                              SelectedValue="{Binding Theme, Mode=TwoWay}"
                                              SelectedValuePath="Value"
                                              Style="{StaticResource NvComboStyle}"
                                              SelectionChanged="ShellTheme_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Actualizaciones" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock x:Name="OfficialReleaseStatusText14" Text="NOVORA comprueba una vez al abrir si hay una release oficial disponible. Si encuentra una versión posterior, permite descargarla, verificarla e instalarla. No se mantiene un sondeo periódico." Style="{StaticResource NvCaptionStyle}" Margin="0,7,0,0"/>
                                <WrapPanel Margin="0,14,0,0">
<Button x:Name="CheckPcUpdateButton14" Content="Buscar actualización de PC" Click="CheckPcUpdate_Click" Style="{StaticResource NvPrimaryButtonStyle}" Margin="0,0,12,12"/>
<Button x:Name="CheckAndroidUpdateButton14" Content="Buscar actualización de LINK Control" Click="CheckAndroidUpdate_Click" Style="{StaticResource NvFlatButtonStyle}" Margin="0,0,0,12"/>
</WrapPanel></StackPanel>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Manual de usuario" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="Español prioritario · English available." Style="{StaticResource NvCaptionStyle}" Margin="0,5,14,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="MANUAL ES" Style="{StaticResource NvPrimaryButtonStyle}" Click="OpenUserManualEs_Click" Margin="0,0,10,0"/>
                                        <Button Content="MANUAL EN" Style="{StaticResource NvPrimaryButtonStyle}" Click="OpenUserManualEn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,18"><StackPanel>
<TextBlock Text="LINK Control · Android" Style="{StaticResource NvSectionTitleStyle}"/>
<TextBlock Text="LinkControl.apk · Descarga en tu teléfono" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
<TextBlock x:Name="AndroidDownloadStatus14" Text="Consulta la versión publicada para obtener el enlace o el QR." Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,12"/>
<WrapPanel><Button x:Name="AndroidDownloadQrButton14" Content="Mostrar QR" Click="ShowAndroidDownloadQr_Click" Style="{StaticResource NvPrimaryButtonStyle}" Margin="0,0,12,12"/>
<Button x:Name="AndroidDownloadCopyButton14" Content="Copiar enlace directo" Click="CopyAndroidDownloadLink_Click" IsEnabled="False" Style="{StaticResource NvFlatButtonStyle}" Margin="0,0,0,12"/></WrapPanel>
<Border x:Name="AndroidDownloadQrFrame14" Visibility="Collapsed" Background="White" Padding="12" HorizontalAlignment="Left"><Image x:Name="AndroidDownloadQrImage14" Width="220" Height="220" Stretch="Uniform" AutomationProperties.Name="QR de descarga privada de LINK Control" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
</StackPanel></Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Instalación local · LINK Control" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock x:Name="AndroidPackageTitle" Text="LINK Control · paquete local" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="AndroidInstallStatus" Text="Conecta un teléfono Android autorizado para comprobar o instalar el paquete local." Style="{StaticResource NvCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="AndroidInstallRefreshButton" Content="COMPROBAR APP" Click="RefreshAndroidInstallation_Click" Style="{StaticResource NvFlatButtonStyle}" Margin="0,0,12,12"/>
                                        <Button x:Name="AndroidInstallButton" Content="INSTALAR NOVORA EN ANDROID" Click="InstallAndroidApp_Click" IsEnabled="False" Style="{StaticResource NvPrimaryButtonStyle}" Margin="0,0,0,12"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
</StackPanel>
                    </ScrollViewer>
            </Grid>

            <!--
                Compatibility bridge.

                Existing partial classes still publish their state into these
                named controls. They are intentionally hidden because the new
                shell exposes the same state in Home/Network/Performance.

                IMPORTANT:
                This bridge does NOT add polling. It only preserves the
                existing event/state contracts.
            -->
            <Grid Visibility="Collapsed">
                <Button x:Name="RefreshDevicesButton"
                        Click="RefreshDevices_Click"/>

                <TextBlock x:Name="AndroidControlStatus"
                       Text="Control detenido."/>

                <Ellipse x:Name="VisionEngineStatusDot14"
                         Width="1"
                         Height="1"/>

                <TextBlock x:Name="VisionEngineUiStatusText"/>

                <!-- LinkEngine contracts consumed by NLUIWindowMain.LinkEngineLE.cs -->
                <TextBlock x:Name="LinkEngineFriendlyConnectionStatus"
                           Text="INACTIVO"/>

                <TextBlock x:Name="LinkEngineFriendlyPhoneStatus"
                           Text="Sin dispositivo"/>

                <TextBlock x:Name="LinkEngineFriendlyUsbStatus"
                           Text="Enlace detenido"/>

                <TextBlock x:Name="LinkEngineFriendlyRecoveryStatus"
                           Text="Recovery inactivo"/>

                <TextBlock x:Name="LinkEngineDeviceStatus"
                           Text="ADB: -"/>

                <TextBlock x:Name="LinkEngineClientStatus"
                           Text="Android: -"/>

                <TextBlock x:Name="LinkEngineTransportStatus"
                           Text="Puerto: -"/>

                <TextBlock x:Name="LinkEngineProtocolStatus"
                           Text="NOVORA-LINK/1"/>

                <TextBlock x:Name="IntegrationStatusText14"
                           Text="Funciones listas."/>

                <!-- VisionEngine contract consumed by NLUIWindowMain.VisionEngineVE.cs -->
                <TextBlock x:Name="EngineFeatureStatus14"
                           Text="VisionEngine detenido"/>
            </Grid>
            <StackPanel HorizontalAlignment="Right" Orientation="Vertical" Grid.Row="2" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</Window>
