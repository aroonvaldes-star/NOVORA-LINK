<Window x:Class="NOVORA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVORA 1.3"
        Width="520" Height="672" MinWidth="460" MinHeight="640"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="24" Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto" MinHeight="113"/>
                <RowDefinition Height="Auto" MinHeight="117"/>
                <RowDefinition/>
                <RowDefinition Height="Auto" MinHeight="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NOVORA" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="LINK" Foreground="{DynamicResource PurpleBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,2" VerticalAlignment="Bottom"/>
                    <Button Content="🔄" Style="{StaticResource ActionButton}" Click="Update_Click" Margin="14,5,0,5" Width="44" ToolTip="Buscar actualizaciones de NOVORA."/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Content="—" Style="{StaticResource ActionButton}" Click="Minimize_Click" Width="36" Height="34" ToolTip="Minimizar NOVORA."/>
                    <Button Content="×" Style="{StaticResource ActionButton}" Click="Close_Click" Width="36" Height="34" ToolTip="Cerrar NOVORA."/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,18,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="DISPOSITIVO ANDROID" Style="{StaticResource SmallLabel}"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="DisplayLabel" SelectedItem="{Binding Device, Mode=TwoWay}" SelectionChanged="Device_SelectionChanged" MinHeight="36" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" x:Name="WifiAdbButton" Content="Wi-Fi" MinHeight="36" Style="{StaticResource ActionButton}" Click="WifiAdb_Click" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" x:Name="RefreshDevicesButton" Content="↻" Width="42" MinHeight="36" Style="{StaticResource ActionButton}" Click="RefreshDevices_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding ConnectionStatus}" Foreground="{DynamicResource GreenBrush}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="18,4,18,2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="MONITOR / SALIDA DE VIDEO" Style="{StaticResource SmallLabel}"/>
                    <ComboBox Grid.Row="1" x:Name="MonitorComboBox" ItemsSource="{Binding Monitors}" DisplayMemberPath="DisplayLabel" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" SelectionChanged="Monitor_SelectionChanged" Margin="0,8,0,5" MinHeight="36"/>
                    <TextBlock Grid.Row="2" Text="{Binding OutputSummary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="18,8,18,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,5,0">
                    <StackPanel><TextBlock Text="RED" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/><TextBlock x:Name="_redStatus" Text="Sin dispositivo conectado." FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,0,0">
                    <StackPanel><TextBlock Text="RENDIMIENTO" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/><TextBlock x:Name="_performanceStatus" Text="Esperando datos..." FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel>
                </Border>
            </Grid>
            <Button Grid.Row="4" Grid.Column="0" Content="CONFIGURACIÓN" Style="{StaticResource ActionButton}" Click="Configuration_Click" Margin="18,0,5,5"/>
            <Button Grid.Row="4" Grid.Column="1" x:Name="InternetUsbButton" Content="INTERNET USB" Style="{StaticResource ActionButton}" Click="Gnirehtet_Click" Margin="5,0,18,5"/>
            <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="18,0,18,0" Background="Transparent" Height="58">
                <Button x:Name="MainActionButton" Content="▶  PLAY" Style="{StaticResource ActionButton}" Click="MainActionButton_Click" Height="58" FontSize="16" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>
