                                                Style="{StaticResource NvFlatButtonStyle}"
                                                Click="RefreshAndroidInstallation_Click"
                                                IsEnabled="True"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <UniformGrid Columns="2" Rows="3">
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,0,7,7">
                                    <StackPanel>
                                        <TextBlock Text="Clipboard" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Android ↔ Windows por eventos, sin historial sensible." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,0,0,7"
                                        AllowDrop="True"
                                        DragOver="IntegrationFiles_DragOver"
                                        Drop="IntegrationFiles_Drop">
                                    <StackPanel>
                                        <TextBlock Text="Archivos / Share" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Suelta aquí archivos o carpetas para enviarlos al teléfono." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,10"/>
                                        <Button Content="RECIBIR CARPETA NOVORA"
                                                Style="{StaticResource NvFlatButtonStyle}"
                                                Click="ReceiveNovoraFolder_Click"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,7,7,7">
                                    <StackPanel>
                                        <TextBlock Text="Apps y notificaciones" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Infraestructura IntegrationVE presente; algunas capacidades dependen del backend Android." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,7,0,7">
                                    <StackPanel>
                                        <TextBlock Text="Display / ventanas" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Virtual display, resize y ventanas se exponen sólo cuando la capacidad está disponible." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="0,7,7,0">
                                    <StackPanel>
                                        <TextBlock Text="Micrófono Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Capacidad Android → PC disponible en la arquitectura actual." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NvCardStyle}" Margin="7,7,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Cámara / PC → Android" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Se muestran como capacidad cuando el backend real las soporte; no se simulan funciones inexistentes." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PRIVACY -->
                    <ScrollViewer x:Name="PrivacyPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Privacidad" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="PrivacyVE protege video, audio, control, gamepad, clipboard y transferencias sin romper la sesión."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Privacy Shield" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock x:Name="PrivacyStatusText14" Text="PrivacyVE listo." Foreground="{DynamicResource TextBrush}" FontSize="15" Margin="0,8,14,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ManualPrivacyButton14" Grid.Column="1" Content="ACTIVAR MANUAL" Style="{StaticResource NvPrimaryButtonStyle}" Click="ManualPrivacy_Click"/>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Protección automática" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="System Secure respeta contenido protegido por Android. Sensitive NLApplicationApp y Secure Input activan la compuerta sin leer contraseñas ni URLs." Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Qué bloquea" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Video visible · audio nuevo · teclado/mouse · gamepad · clipboard · File/Image/Media · grabación futura." Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SETTINGS -->
                    <ScrollViewer x:Name="SettingsPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configuración" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Sólo opciones globales. Pantalla, red, rendimiento y game input viven en sus propias secciones."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tema" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Cambia la apariencia de NOVORA en vivo." Style="{StaticResource NvCaptionStyle}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ThemeOptions}"
                                              SelectedValue="{Binding Theme, Mode=TwoWay}"
                                              SelectedValuePath="Value"
                                              Style="{StaticResource NvComboStyle}"
                                              SelectionChanged="ShellTheme_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Actualizaciones" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock x:Name="OfficialReleaseStatusText14" Text="NOVORA comprueba una vez al abrir si hay una release oficial disponible. Si encuentra una versión posterior, permite descargarla, verificarla e instalarla. No se mantiene un sondeo periódico." Style="{StaticResource NvCaptionStyle}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Manual de usuario" Style="{StaticResource NvSectionTitleStyle}"/>
                                    <TextBlock Text="Español prioritario · English available." Style="{StaticResource NvCaptionStyle}" Margin="0,5,14,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="MANUAL ES" Style="{StaticResource NvPrimaryButtonStyle}" Click="OpenUserManualEs_Click" Margin="0,0,10,0"/>
                                        <Button Content="MANUAL EN" Style="{StaticResource NvPrimaryButtonStyle}" Click="OpenUserManualEn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!--
                Compatibility bridge.

                Existing partial classes still publish their state into these
                named controls. They are intentionally hidden because the new
                shell exposes the same state in Home/Network/Performance.

                IMPORTANT:
                This bridge does NOT add polling. It only preserves the
                existing event/state contracts.
            -->
            <Grid Visibility="Collapsed">
                <Button x:Name="RefreshDevicesButton"
                        Click="RefreshDevices_Click"/>

                <TextBlock x:Name="AndroidControlStatus"
                       Text="Control detenido."/>

                <Ellipse x:Name="VisionEngineStatusDot14"
                         Width="1"
                         Height="1"/>

                <TextBlock x:Name="VisionEngineUiStatusText"/>

                <!-- LinkEngine contracts consumed by NLUIWindowMain.LinkEngineLE.cs -->
                <TextBlock x:Name="LinkEngineFriendlyConnectionStatus"
                           Text="INACTIVO"/>

                <TextBlock x:Name="LinkEngineFriendlyPhoneStatus"
                           Text="Sin dispositivo"/>

                <TextBlock x:Name="LinkEngineFriendlyUsbStatus"
                           Text="Internet USB detenido"/>

                <TextBlock x:Name="LinkEngineFriendlyRecoveryStatus"
                           Text="Recovery inactivo"/>

                <TextBlock x:Name="LinkEngineDeviceStatus"
                           Text="ADB: -"/>

                <TextBlock x:Name="LinkEngineClientStatus"
                           Text="Android: -"/>

                <TextBlock x:Name="LinkEngineTransportStatus"
                           Text="Puerto: -"/>

                <TextBlock x:Name="LinkEngineProtocolStatus"
                           Text="NOVORA-LINK/1"/>

                <TextBlock x:Name="IntegrationStatusText14"
                           Text="Funciones listas."/>

                <!-- VisionEngine contract consumed by NLUIWindowMain.VisionEngineVE.cs -->
                <TextBlock x:Name="EngineFeatureStatus14"
                           Text="VisionEngine detenido"/>
            </Grid>
            <StackPanel HorizontalAlignment="Right" Orientation="Vertical" Grid.Row="2" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</Window>
