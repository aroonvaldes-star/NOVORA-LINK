<Window
    x:Class="NOVORA.NLUIWindowMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:NOVORA"
    mc:Ignorable="d"
    Title="NOVORA-LINK 1.4"
    Width="1080"
    Height="700"
    MinWidth="940"
    MinHeight="610"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="{DynamicResource WindowBrush}"
    Loaded="Window_Loaded"
    StateChanged="Window_StateChanged"
    Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="NvCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="NvWindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D506F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0B2B45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BlueDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvFlatButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush2}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource InputSelectedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvNavButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter Margin="2,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                                <Setter TargetName="NavBorder" Property="BorderThickness" Value="2"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NvComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>

        <Style x:Key="NvPageTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="NvSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NvCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="NvMetricProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="NvBatteryProgressStyle" TargetType="ProgressBar">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="118"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="ShellRoot14" Loaded="ShellRoot_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP TITLE BAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Asset/NLAssetNOVORABRAND.png"
                               Width="281"
                               Height="54"
                               Stretch="Uniform"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="1.4"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="18"
                                   Margin="10,1,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DeviceDisplayName}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="➖"
                                FontFamily="Segoe MDL2 Assets"
                                AutomationProperties.Name="Minimizar NOVORA"
                                ToolTip="Minimizar"
                                 Style="{StaticResource NvWindowButtonStyle}"
                                 Click="Minimize_Click"/>
                        <Button x:Name="MaximizeRestoreButton14"
                                Content="□"
                                AutomationProperties.Name="Maximizar NOVORA"
                                ToolTip="Maximizar"
                                Style="{StaticResource NvWindowButtonStyle}"
                                Click="MaximizeRestore_Click"/>
                        <Button Content="×"
                                 FontFamily="Segoe MDL2 Assets"
                                AutomationProperties.Name="Cerrar NOVORA"
                                ToolTip="Cerrar"
                                Style="{StaticResource NvWindowButtonStyle}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- EVENT / UPDATE MESSAGE BAR. No polling. -->
            <Border x:Name="TopMessageBorder14"
                    Grid.Row="1"
                    Background="{DynamicResource PanelBrush2}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="TopMessageDot14"
                             Width="9" Height="9"
                             Fill="{DynamicResource GreenBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TopMessageText14"
                               Grid.Column="1"
                               Text="NOVORA listo."
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="UpdateBannerActionButton14"
                            Grid.Column="2"
                            Content="DESCARGAR ACTUALIZACIÓN"
                            Visibility="Collapsed"
                            Height="44"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource NvFlatButtonStyle}"
                            Click="InstallUpdateBanner_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="12,16,12,0">
                            <TextBlock Text="NAVEGACIÓN"
                                       Margin="14,0,0,8"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <Button x:Name="NavHome14" Tag="Home" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌂" FontSize="20" Width="36"/>
                                    <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavScreen14" Tag="Screen" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◉" FontSize="16" Width="36" VerticalAlignment="Center"/>
                                    <TextBlock Text="VisionEngine" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavNetwork14" Tag="Network" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌁" FontSize="19" Width="36" VerticalAlignment="Center"/>
                                    <TextBlock Text="LinkEngine" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavGameInput14" Tag="GameInput" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="18" Width="36" VerticalAlignment="Center"/>
                                    <TextBlock Text="ExInEngine" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavIntegration14" Tag="Integration" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↔" FontSize="20" Width="36"/>
                                    <TextBlock Text="Integración" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavPrivacy14" Tag="Privacy" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◆" FontSize="16" Width="36"/>
                                    <TextBlock Text="Privacidad" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="12,0,12,12">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0,8,8"/>
                            <Button x:Name="NavSettings14" Tag="Settings" Click="NavigationButton_Click" Style="{StaticResource NvNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" FontSize="18" Width="36"/>
                                    <TextBlock Text="Configuración" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAGE HOST -->
                <Grid x:Name="PageHost14" Grid.Column="1" Margin="22,18,22,22" ClipToBounds="True">

                    <!-- HOME -->
                    <ScrollViewer x:Name="HomePage14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Conecta tu teléfono" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Usa un cable USB o conéctalo por Wi-Fi. Después podrás ver su pantalla en esta PC." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource NvCaptionStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DeviceDisplayName}" Foreground="{DynamicResource BlueBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="MainActionButton"
                                                Content="VER PANTALLA"
                                                Style="{StaticResource NvPrimaryButtonStyle}"
                                                Click="MainActionButton_Click"
                                                Width="156"
                                                Height="42"
                                                ToolTip="Mostrar la pantalla del teléfono"/>
                                        <Button x:Name="HomeLanConnectionButton"
                                                Content="CONECTAR POR LAN"
                                                Style="{StaticResource NvFlatButtonStyle}"
                                                Click="HomeLanConnectionButton_Click"
                                                Width="164"
                                                Height="42"
                                                Margin="10,0,0,0"
                                                ToolTip="Conectar el teléfono por Wi-Fi"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Pantalla del teléfono" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="La calidad elegida se aplicará al iniciar." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,10"/>
                                        <TextBlock Text="{Binding OutputSummary}" Foreground="{DynamicResource BlueBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="VisionLiveTelemetryText14" Text="La pantalla aún no se está mostrando." Style="{StaticResource NvCaptionStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource NvCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Controles" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <TextBlock Text="Mando y entradas disponibles para el teléfono." Style="{StaticResource NvCaptionStyle}" Margin="0,6,0,10"/>
                                        <TextBlock x:Name="HomeGamepadStatusText14" Text="{Binding Text, ElementName=GamepadStatusText14}" Foreground="{DynamicResource TextBrush}" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="HomeGamepadCountText14" Text="{Binding Text, ElementName=GamepadCountText14}" Style="{StaticResource NvCaptionStyle}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="HomeExInBatteryText14" Text="{Binding Text, ElementName=ExInBatteryText14}" Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,0"/>
                                        <Button x:Name="HomeExInReactivateButton14" Content="REACTIVAR CONTROL" Style="{StaticResource NvFlatButtonStyle}" Click="ExInReactivate_Click" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SCREEN / VISIONENGINE SETTINGS -->
                    <ScrollViewer x:Name="ScreenPage14" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="VisionEngine · Configuración" Style="{StaticResource NvPageTitleStyle}"/>
                            <TextBlock Text="Ajustes del motor de video, audio y salida visual."
                                       Style="{StaticResource NvCaptionStyle}" Margin="0,4,0,18"/>

                            <Border Style="{StaticResource NvCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Modo" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding VideoPresentationModeOptions}"
                                                  SelectedValue="{Binding VideoPresentationMode, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Monitor" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding Monitors}"
                                                  SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellMonitor_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayLabel}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Salida de audio" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding AudioOutputOptions}"
                                                  SelectedValue="{Binding SelectedAudioOutput, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Calidad / bitrate" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding BitrateOptions}"
                                                  SelectedValue="{Binding Bitrate, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="FPS" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding FpsOptions}"
                                                  SelectedValue="{Binding TargetFps, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,14">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Resolución" Style="{StaticResource NvSectionTitleStyle}"/>
                                        <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                                  SelectedValue="{Binding MaxSize, Mode=TwoWay}"
                                                  SelectedValuePath="Value"
                                                  Style="{StaticResource NvComboStyle}"
                                                  SelectionChanged="ShellVideoOption_SelectionChanged" Margin="0,8,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource InputForegroundBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Aceleración de VisionEngine" Style="{StaticResource NvSectionTitleStyle}"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,2">
                                                <Ellipse x:Name="NvidiaStatusDot14"
                                                     Width="9"
                                                     Height="9"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="NvidiaStatusTitle14"
                                                       Text="Aceleración aún no evaluada."
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>

                                            <TextBlock x:Name="NvidiaCapabilitiesText14"
                                                   Text="CUDA: - · NVDEC: - · NVENC: -"
                                                   Style="{StaticResource NvCaptionStyle}"
                                                   Margin="17,3,0,0"
                                                   TextWrapping="Wrap"/>

                                            <TextBlock x:Name="NvidiaBackendText14"
                                                   Text="Backend: FFmpeg"
                                                   Style="{StaticResource NvCaptionStyle}"
                                                   Margin="17,3,0,0"
                                                   TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Modo de VisionEngine" Style="{StaticResource NvSectionTitleStyle}"/>

