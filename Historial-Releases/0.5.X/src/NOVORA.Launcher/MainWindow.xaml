<Window x:Class="NOVORA.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVORA"
        Width="980"
        Height="620"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border BorderBrush="#293345" BorderThickness="1" CornerRadius="12" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="96" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#080C13" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Source="Assets/novora-logo.png" Width="38" Height="38" Stretch="Uniform" Margin="0,0,12,0" />
                    <TextBlock Text="NOVORA" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="—" Width="52" Height="42" Click="Minimize_Click" Style="{StaticResource ActionButton}" BorderThickness="0" />
                    <Button Content="□" Width="52" Height="42" Click="Maximize_Click" Style="{StaticResource ActionButton}" BorderThickness="0" />
                    <Button Content="×" Width="52" Height="42" Click="Close_Click" Style="{StaticResource ActionButton}" BorderThickness="0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,16,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="DISPOSITIVO ANDROID" Style="{StaticResource SmallLabel}" />
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding Device, Mode=TwoWay}"
                                  SelectionChanged="Device_SelectionChanged"
                                  Margin="0,7,0,4"
                                  MinHeight="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="#111111"
                                               Background="#F2F2F2"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding ConnectionStatus}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="MONITOR DE SALIDA" Style="{StaticResource SmallLabel}" />
                        <ComboBox ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor}"
                                  SelectionChanged="Monitor_SelectionChanged"
                                  Margin="0,7,0,4"
                                  MinHeight="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               Foreground="#111111"
                                               Background="#F2F2F2"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Monitor para la ventana de scrcpy"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="CALIDAD DE SALIDA" Style="{StaticResource SmallLabel}" />
                        <TextBlock Text="{Binding PerformanceSummary}"
                                   Foreground="{StaticResource BlueBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Bitrate fijo: 10 Mb/s"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="16,0,16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="NOVORA — LISTO PARA TRANSMITIR"
                               Style="{StaticResource SectionTitle}" />
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Selecciona tu dispositivo y pulsa INICIAR NOVORA."
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="Gnirehtet es opcional y se activa manualmente cuando lo necesites."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="GNIREHTET" Style="{StaticResource SmallLabel}" />
                        <TextBlock Text="{Binding GnirehtetStatus}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="CONFIGURACIÓN" Style="{StaticResource SmallLabel}" />
                        <TextBlock Text="Audio de scrcpy"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ESTADO" Style="{StaticResource SmallLabel}" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="⚙  CONFIGURACIÓN"
                        Style="{StaticResource ActionButton}"
                        Click="Configuration_Click"
                        Margin="0,0,6,0" />

                <Button Grid.Column="1"
                        Style="{StaticResource ActionButton}"
                        Click="Start_Click"
                        Margin="6,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="▶" Foreground="{StaticResource GreenBrush}" FontSize="24" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="INICIAR NOVORA" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Content="■  DETENER NOVORA"
                        ToolTip="Detener scrcpy, Gnirehtet y limpiar ADB cuando no haya otros dispositivos."
                        Style="{StaticResource DangerButton}"
                        Click="Stop_Click"
                        Margin="6,0" />

                <Button Grid.Column="3"
                        Content="↔  GNIREHTET"
                        Style="{StaticResource ActionButton}"
                        Click="Gnirehtet_Click"
                        Margin="6,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
