<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NOVORA"
    Width="900"
    Height="600"
    MinWidth="760"
    MinHeight="500"
    Background="#0D1117"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ========================= -->
        <!-- NOVORA DESIGN SYSTEM V1    -->
        <!-- ========================= -->

        <SolidColorBrush x:Key="NovaBackground" Color="#0D1117"/>
        <SolidColorBrush x:Key="NovaSurface" Color="#161B22"/>
        <SolidColorBrush x:Key="NovaSurfaceAlt" Color="#1C2128"/>
        <SolidColorBrush x:Key="NovaBorder" Color="#30363D"/>

        <SolidColorBrush x:Key="NovaText" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="NovaTextSecondary" Color="#8B949E"/>

        <SolidColorBrush x:Key="NovaPrimary" Color="#1F6FEB"/>
        <SolidColorBrush x:Key="NovaSuccess" Color="#2EA043"/>
        <SolidColorBrush x:Key="NovaWarning" Color="#D29922"/>
        <SolidColorBrush x:Key="NovaError" Color="#F85149"/>

        <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource NovaTextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusName" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource NovaText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource NovaSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NovaBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="NOVORA"
                Foreground="{StaticResource NovaText}"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>

            <Button
                Grid.Column="1"
                Content="📖"
                Width="42"
                Height="36"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{StaticResource NovaText}"
                FontSize="18"
                ToolTip="Manual"/>

        </Grid>


        <!-- ========================= -->
        <!-- MAIN -->
        <!-- ========================= -->

        <Grid Grid.Row="1" Margin="0,10,0,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- TELEFONO -->

            <Border
                Grid.Row="0"
                Style="{StaticResource PanelStyle}"
                Padding="18"
                Margin="0,0,0,10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Teléfono"
                        Style="{StaticResource StatusName}"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="●  Conectado"
                        Foreground="{StaticResource NovaSuccess}"
                        FontSize="15"
                        VerticalAlignment="Center"/>

                </Grid>

            </Border>


            <!-- SERVICIOS -->

            <Border
                Grid.Row="1"
                Style="{StaticResource PanelStyle}"
                Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ADB -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="ADB"
                            Style="{StaticResource StatusName}"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="●  Conectado"
                            Foreground="{StaticResource NovaSuccess}"
                            FontSize="14"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <!-- SCRCPY -->

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Scrcpy"
                            Style="{StaticResource StatusName}"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="●  Conectado"
                            Foreground="{StaticResource NovaSuccess}"
                            FontSize="14"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <!-- NIRCMD -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="NirCmd"
                            Style="{StaticResource StatusName}"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="●  Conectado"
                            Foreground="{StaticResource NovaSuccess}"
                            FontSize="14"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <!-- GNIREHTET -->

                    <Border
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Padding="14"
                        Background="{StaticResource NovaSurfaceAlt}"
                        BorderBrush="{StaticResource NovaBorder}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock
                                    Text="Gnirehtet"
                                    Style="{StaticResource StatusName}"/>

                                <TextBlock
                                    Text="Conexión establecida"
                                    Foreground="{StaticResource NovaSuccess}"
                                    FontSize="13"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                            <!-- SWITCH VISUAL TEMPORAL -->

                            <Border
                                Grid.Column="1"
                                Width="52"
                                Height="28"
                                CornerRadius="14"
                                Background="{StaticResource NovaSuccess}"
                                VerticalAlignment="Center">

                                <Ellipse
                                    Width="22"
                                    Height="22"
                                    Fill="White"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,3,0"/>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================= -->
        <!-- FOOTER -->
        <!-- ========================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>


            <!-- CONFIG -->

            <Button
                Content="⚙"
                Width="52"
                Height="52"
                Background="{StaticResource NovaSurface}"
                BorderBrush="{StaticResource NovaBorder}"
                BorderThickness="1"
                Foreground="{StaticResource NovaText}"
                FontSize="22"/>


            <!-- BOTON PRINCIPAL -->

            <Button
                Grid.Column="1"
                Height="58"
                Margin="18,0"
                Background="{StaticResource NovaPrimary}"
                BorderThickness="0"
                Foreground="White"
                FontSize="17"
                FontWeight="SemiBold"
                Content="▶  INICIAR"/>


            <!-- PERFIL -->

            <Button
                Grid.Column="2"
                Content="♙"
                Width="52"
                Height="52"
                Background="{StaticResource NovaSurface}"
                BorderBrush="{StaticResource NovaBorder}"
                BorderThickness="1"
                Foreground="{StaticResource NovaText}"
                FontSize="22"/>

        </Grid>

    </Grid>

</Window>
