<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NOVORA Design System V1 -->
    <!-- Color Palette -->

    <!-- Background -->
    <Color x:Key="NovaBackgroundColor">#0D1117</Color>
    <Color x:Key="NovaSurfaceColor">#161B22</Color>
    <Color x:Key="NovaSurfaceAltColor">#1C2128</Color>

    <!-- Borders -->
    <Color x:Key="NovaBorderColor">#30363D</Color>

    <!-- Brand -->
    <Color x:Key="NovaPrimaryColor">#1F6FEB</Color>

    <!-- Status -->
    <Color x:Key="NovaSuccessColor">#2EA043</Color>
    <Color x:Key="NovaWarningColor">#D29922</Color>
    <Color x:Key="NovaErrorColor">#F85149</Color>

    <!-- Text -->
    <Color x:Key="NovaTextColor">#F0F6FC</Color>
    <Color x:Key="NovaTextSecondaryColor">#8B949E</Color>

    <!-- Brushes -->

    <SolidColorBrush
        x:Key="NovaBackgroundBrush"
        Color="{StaticResource NovaBackgroundColor}" />

    <SolidColorBrush
        x:Key="NovaSurfaceBrush"
        Color="{StaticResource NovaSurfaceColor}" />

    <SolidColorBrush
        x:Key="NovaSurfaceAltBrush"
        Color="{StaticResource NovaSurfaceAltColor}" />

    <SolidColorBrush
        x:Key="NovaBorderBrush"
        Color="{StaticResource NovaBorderColor}" />

    <SolidColorBrush
        x:Key="NovaPrimaryBrush"
        Color="{StaticResource NovaPrimaryColor}" />

    <SolidColorBrush
        x:Key="NovaSuccessBrush"
        Color="{StaticResource NovaSuccessColor}" />

    <SolidColorBrush
        x:Key="NovaWarningBrush"
        Color="{StaticResource NovaWarningColor}" />

    <SolidColorBrush
        x:Key="NovaErrorBrush"
        Color="{StaticResource NovaErrorColor}" />

    <SolidColorBrush
        x:Key="NovaTextBrush"
        Color="{StaticResource NovaTextColor}" />

    <SolidColorBrush
        x:Key="NovaTextSecondaryBrush"
        Color="{StaticResource NovaTextSecondaryColor}" />

</ResourceDictionary>