<Window x:Class="NOVORA.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NOVORA 1.2" Width="520" Height="900" MinWidth="460" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBrush}" Loaded="Window_Loaded" Closing="Window_Closing">

    <Border BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="1"
        CornerRadius="24"
        Background="{DynamicResource WindowBrush}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- BARRA DE TÍTULO -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
              Background="{DynamicResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                   Source="Assets/novora-logo.png"
                   Width="40"
                   Height="40"
                   Margin="16,0,10,0"
                   VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <TextBlock Text="NOVORA"
                           FontSize="21"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                    <TextBlock Text="LINK"
                           Foreground="{DynamicResource PurpleBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="6,0,0,7" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">

                    <Button Content="—"
                        Style="{StaticResource ActionButton}"
                        Click="Minimize_Click"
                        Width="36"
                        Height="34"
                        ToolTip="Minimizar NOVORA."/>

                    <Button Content="×"
                        Style="{StaticResource ActionButton}"
                        Click="Close_Click"
                        Width="36"
                        Height="34"
                        Margin="3,0,0,0"
                        ToolTip="Cerrar NOVORA."/>
                </StackPanel>
            </Grid>

            <!-- ================================================= -->
            <!-- DISPOSITIVO -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                Margin="18,18,18,8"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                           Text="DISPOSITIVO ANDROID"
                           Style="{StaticResource SmallLabel}"/>

                    <Grid Grid.Row="1"
                      Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Devices}"
                              DisplayMemberPath="DisplayLabel"
                              SelectedItem="{Binding Device, Mode=TwoWay}"
                              SelectionChanged="Device_SelectionChanged"
                              MinHeight="36"
                              Margin="0,0,6,0"
                              ToolTip="Selecciona el dispositivo Android."/>

                        <Button Grid.Column="1"
                            x:Name="WifiAdbButton"
                            Content="Wi-Fi"
                            MinHeight="36"
                            Style="{StaticResource ActionButton}"
                            Click="WifiAdb_Click"
                            Margin="0,0,6,0"
                            ToolTip="Conectar mediante ADB Wi-Fi."/>

                        <Button Grid.Column="2"
                            x:Name="RefreshDevicesButton"
                            Content="↻"
                            Width="42"
                            MinHeight="36"
                            Style="{StaticResource ActionButton}"
                            Click="RefreshDevices_Click"
                            ToolTip="Buscar dispositivos nuevamente."/>
                    </Grid>

                    <TextBlock Grid.Row="2"
                           Text="{Binding ConnectionStatus}"
                           Foreground="{DynamicResource GreenBrush}"
                           FontSize="11"
                           Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- MONITOR / SALIDA -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                Margin="18,8,18,8"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                           Text="MONITOR / SALIDA DE VIDEO"
                           Style="{StaticResource SmallLabel}"/>

                    <ComboBox Grid.Row="1"
                          x:Name="MonitorComboBox"
                          ItemsSource="{Binding Monitors}"
                          DisplayMemberPath="DisplayLabel"
                          SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                          SelectionChanged="Monitor_SelectionChanged"
                          Margin="0,8,0,5"
                          MinHeight="36"
                          ToolTip="Selecciona el monitor de salida."/>

                    <TextBlock Grid.Row="2"
                           Text="{Binding OutputSummary}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Configuración actual de salida de vídeo."/>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <Grid Grid.Row="3"
              Margin="18,8,18,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RED -->

                <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,5,0">

                    <StackPanel>

                        <TextBlock Text="RED"
                               Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBlock x:Name="_redStatus"
                               Text="Sin dispositivo conectado."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               ToolTip="Estado de ADB, red, Internet, latencia y Gnirehtet." HorizontalAlignment="Center"/>

                    </StackPanel>
                </Border>

                <!-- RENDIMIENTO -->

                <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="5,0,0,0">

                    <StackPanel>

                        <TextBlock Text="RENDIMIENTO"
                               Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBlock x:Name="_performanceStatus"
                               Text="Esperando datos..."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               ToolTip="CPU, memoria, batería y temperatura." HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </StackPanel>
                </Border>

            </Grid>

            <!-- ================================================= -->
            <!-- HERRAMIENTAS -->
            <!-- ================================================= -->

            <Border Grid.Row="4"
                Margin="18,8,18,8"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="HERRAMIENTAS"
                           Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <UniformGrid Columns="2"
                             Margin="0,8,0,0">

                        <Button Content="INTERNET USB"
                            Style="{StaticResource ActionButton}"
                            Click="Gnirehtet_Click"
                            Margin="0,0,4,4"
                            ToolTip="Iniciar o detener Internet USB."/>

                        <Button Content="CAPTURA"
                            Style="{StaticResource ActionButton}"
                            Click="Capture_Click"
                            Margin="4,0,0,4"
                            ToolTip="Capturar la pantalla del dispositivo."/>

                        <Button Content="CONFIGURACIÓN"
                            Style="{StaticResource ActionButton}"
                            Click="Configuration_Click"
                            Margin="0,4,4,0"
                            ToolTip="Abrir la configuración de NOVORA."/>

                        <Button Content="ACTUALIZACIONES"
                            Style="{StaticResource ActionButton}"
                            Click="Update_Click"
                            Margin="4,4,0,0"
                            ToolTip="Buscar actualizaciones de NOVORA."/>

                    </UniformGrid>

                </StackPanel>
            </Border>

            <!-- ================================================= -->
            <!-- PLAY / STOP -->
            <!-- ================================================= -->

            <Border Grid.Row="5"
                Margin="18,8,18,18"
                Background="Transparent">

                <Button x:Name="MainActionButton"
                    Content="▶  PLAY"
                    Style="{StaticResource ActionButton}"
                    Click="MainActionButton_Click"
                    Height="58"
                    FontSize="16"
                    FontWeight="Bold"
                    ToolTip="Iniciar o detener NOVORA."/>

            </Border>

        </Grid>
    </Border>

</Window>