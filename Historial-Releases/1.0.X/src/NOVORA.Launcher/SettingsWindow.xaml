<Window x:Class="NOVORA.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — NOVORA"
        Width="520" Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}">
    <Border BorderBrush="#293345" BorderThickness="1" CornerRadius="12" Padding="22"
            Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CONFIGURACIÓN DE NOVORA"
                       FontSize="20" FontWeight="Bold"/>

            <StackPanel Grid.Row="1" Margin="0,24,0,20">
                <TextBlock Text="AUDIO" Style="{StaticResource SmallLabel}"/>
                <CheckBox IsChecked="{Binding AudioEnabled}"
                          Content="Activar audio de scrcpy"
                          Margin="0,8,0,18"
                          FontSize="14"/>

                <TextBlock Text="El monitor y el perfil de salida se pueden seleccionar desde la pantalla principal."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Width="100" Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}"
                        Click="Cancel_Click"/>
                <Button Content="Guardar"
                        Width="110"
                        Style="{StaticResource ActionButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
