+        if (string.IsNullOrWhiteSpace(serial)) return;
+
+        NLServiceNovoraPaths paths = new(AppContext.BaseDirectory);
+        NLServiceADB adb = new(paths);
+        await using ExInCoreEngine exIn = new(paths);
+        await exIn.InitializeAsync();
