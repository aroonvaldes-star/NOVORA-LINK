<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>NOVORA.ProfileHarness.NLTestProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NOVORA/NLProjectDesktop.csproj" />
    <Content Include="../../src/NOVORA/Tools/**/*">
      <Link>Tools/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
