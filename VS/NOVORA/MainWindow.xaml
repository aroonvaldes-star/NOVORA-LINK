<Window x:Class="NOVORA.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NOVORA 1.2 — Modo prueba final" Width="980" Height="640" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="NOVORA 1.2" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="Modo prueba final · base reorganizada" Opacity="0.7" Margin="0,4,0,20"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="Estado" Margin="0,0,10,0">
        <StackPanel Margin="16">
          <TextBlock x:Name="ConnectionText" Text="● SIN DISPOSITIVO" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock x:Name="ProfileText" Text="Perfil: pendiente"/>
          <TextBlock x:Name="RecoveryText" Text="Recovery: listo" Margin="0,6,0,0"/>
          <TextBlock x:Name="PollingText" Text="Polling: desactivado por defecto" Margin="0,6,0,0"/>
        </StackPanel>
      </GroupBox>
      <GroupBox Grid.Column="1" Header="Pruebas" Margin="10,0,0,0">
        <StackPanel Margin="16">
          <Button Content="Ejecutar prueba de bitrate" Click="BitrateTest_Click" Height="42" Margin="0,0,0,10"/>
          <Button Content="Probar recuperación" Click="RecoveryTest_Click" Height="42" Margin="0,0,0,10"/>
          <Button Content="Simular estado conectado" Click="ConnectTest_Click" Height="42"/>
        </StackPanel>
      </GroupBox>
    </Grid>
    <TextBlock Grid.Row="2" Text="NOVORA 1.2 · Prueba final · WPF/C# · sin polling agresivo" Opacity="0.65" Margin="0,18,0,0"/>
  </Grid>
</Window>
